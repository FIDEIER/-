@model IEnumerable<КУРСАЧ.Models.Book>

@{
    ViewData["Title"] = "Панель управления";
}

<h1>Панель управления каталогом</h1>

<div class="admin-actions">
    <a href="/Admin/AddBook" class="btn-add">+ Добавить книгу</a>
    <a href="/Account/Logout" class="btn-logout">Выйти</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Авторы</th>
            <th>Год</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@string.Join(", ", book.Authors.Select(a => a.Name))</td>
                    <td>@book.Year</td>
                    <td>@book.Status</td>
                    <td class="actions">
                        <a href="/Admin/EditBook/@book.Id" class="btn-edit">Редактировать</a>
                        <form method="post" action="/Admin/DeleteBook/@book.Id" style="display:inline;">
                            <button type="submit" class="btn-delete" onclick="return confirm('Удалить книгу?')">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" style="text-align:center;">Книги не найдены</td>
            </tr>
        }
    </tbody>
</table>

<style>
    .admin-actions {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        align-items: center;
    }

    .btn-add {
        padding: 10px 20px;
        background-color: #28a745;
        color: white;
        border-radius: 4px;
        text-decoration: none;
    }

        .btn-add:hover {
            background-color: #218838;
        }

    .btn-logout {
        padding: 10px 20px;
        background-color: #dc3545;
        color: white;
        border-radius: 4px;
        text-decoration: none;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .admin-table th, .admin-table td {
            border: 1px solid #ddd;
            padding: 10px 12px;
            text-align: left;
        }

        .admin-table th {
            background-color: #f2f2f2;
        }

    .actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-edit {
        padding: 4px 12px;
        background-color: #ffc107;
        color: #000;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
    }

    .btn-delete {
        padding: 4px 12px;
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }
</style>